    "qrpay/types/Order": {
      "title": "Order",
      "description": "A single order lives as a UTXO at the escrow validator address.\n The `usdc_amount` of asset `(usdc_policy, usdc_name)` is locked alongside.",
      "anyOf": [
        {
          "title": "Order",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "order_id",
              "description": "Unique id. In practice = tx hash of the placeOrder tx, set off-chain\n so the SDK can reference it before the tx confirms.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "user",
              "description": "Pkh of the user who placed the order.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "merchant",
              "description": "Pkh of the merchant who accepted. `None` until Accepted.",
              "$ref": "#/definitions/Option<aiken~1crypto~1VerificationKeyHash>"
            },
            {
              "title": "merchant_pubkey",
              "description": "Merchant's secp256k1 pubkey (uncompressed, no 0x04 prefix) for ECIES\n encryption of the payment address. Empty until Accepted.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "usdc_policy",
              "description": "Which asset is escrowed.",
              "$ref": "#/definitions/cardano~1assets~1PolicyId"
            },
            {
              "title": "usdc_name",
              "$ref": "#/definitions/cardano~1assets~1AssetName"
            },
            {
              "title": "usdc_amount",
              "description": "Amount of USDC (6dp).",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "fiat_currency",
              "description": "Fiat currency code, e.g. \"INR\".",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "fiat_amount",
              "description": "Fiat amount in the smallest unit (paise, cents, etc).",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "encrypted_payment_addr",
              "description": "ECIES ciphertext of the target UPI/PIX/etc address, encrypted for the\n merchant. Empty until user pushes it via SetPaymentAddr.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "status",
              "description": "Current lifecycle status.",
              "$ref": "#/definitions/qrpay~1types~1Status"
            },
            {
              "title": "accept_deadline",
              "description": "POSIX ms after which the user can cancel if no merchant accepted.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "complete_deadline",
              "description": "POSIX ms after which the user can force-refund if the merchant\n accepted but never called Complete.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "dispute_deadline",
              "description": "POSIX ms until which the user can dispute after MarkPaid.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "admin",
              "description": "Admin (resolver) pkh. Only used on Resolve.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            }
          ]
        }
      ]
    },
    "qrpay/types/Status": {
      "title": "Status",
      "description": "Lifecycle of a single escrow order.\n\n Placed    -> user locked USDC; awaiting a merchant to accept.\n Accepted  -> a merchant took the order; user should push encrypted UPI id.\n Paid      -> user (or merchant, in fast-path) signalled fiat leg completed.\n              Merchant can now claim USDC after the dispute window elapses\n              unless a dispute is raised.\n Disputed  -> either party escalated; admin resolves.",
      "anyOf": [
        {
          "title": "Placed",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "Accepted",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        },
        {
          "title": "Paid",
          "dataType": "constructor",
          "index": 2,
          "fields": []
        },
        {
          "title": "Disputed",
          "dataType": "constructor",
          "index": 3,
          "fields": []
        }
      ]
    }
