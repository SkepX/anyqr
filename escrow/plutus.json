    "qrpay/types/Action": {
      "title": "Action",
      "description": "Actions on an escrow UTXO.",
      "anyOf": [
        {
          "title": "Accept",
          "description": "Merchant claims the order and publishes their ECIES pubkey.",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "merchant",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "merchant_pubkey",
              "$ref": "#/definitions/ByteArray"
            }
          ]
        },
        {
          "title": "SetPaymentAddr",
          "description": "User attaches the encrypted payment address after seeing merchant pubkey.",
          "dataType": "constructor",
          "index": 1,
          "fields": [
            {
              "title": "encrypted",
              "$ref": "#/definitions/ByteArray"
            }
          ]
        },
        {
          "title": "MarkPaid",
          "description": "User (or fast-path merchant) marks the fiat leg as sent. Starts dispute\n window.",
          "dataType": "constructor",
          "index": 2,
          "fields": []
        },
        {
          "title": "Complete",
          "description": "Merchant claims the locked USDC. Only valid after dispute_deadline\n and while status is Paid.",
          "dataType": "constructor",
          "index": 3,
          "fields": []
        },
        {
          "title": "CancelUnaccepted",
          "description": "User cancels an unaccepted order and reclaims USDC.",
          "dataType": "constructor",
          "index": 4,
          "fields": []
        },
        {
          "title": "Refund",
          "description": "User force-refunds after the merchant accepted but never completed.",
          "dataType": "constructor",
          "index": 5,
          "fields": []
        },
        {
